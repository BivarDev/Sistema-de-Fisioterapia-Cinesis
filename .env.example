# ---------------------------------------------------------------------------
# Cinesis — configuracao de ambiente
#
# Copie para `.env` e ajuste. O arquivo `.env` NUNCA vai para o Git.
#
# Em desenvolvimento, tudo abaixo tem valor padrao razoavel: `npm run dev`
# funciona sem editar nada. Em producao, a aplicacao RECUSA subir com os
# valores de exemplo — ver `apps/api/src/config.ts`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3333
HOST=127.0.0.1

# --- Chave de cifragem -----------------------------------------------------
# Protege a PII do paciente em repouso e deriva o codigo pseudonimizado.
#
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# PERDER ESTA CHAVE TORNA A PII IRRECUPERAVEL. Guarde-a com o mesmo cuidado
# que voce guarda o backup do banco — e em lugar SEPARADO dele.
#
# Rotacao: acrescente CINESIS_KEY_V2 com uma chave nova e MANTENHA a V1. O
# sistema passa a escrever com a V2 e continua lendo o que foi escrito com a V1.
CINESIS_KEY_V1=VFJPUVVFLUVTVEEtQ0hBVkUtRU0tUFJPRFVDQU8hISE=

# --- Banco de dados --------------------------------------------------------
# Vazio em desenvolvimento: usa PostgreSQL embutido (PGlite), sem instalar nada.
# Obrigatorio em producao.
# DATABASE_URL=postgres://cinesis:senha@localhost:5432/cinesis

# --- Sessao ----------------------------------------------------------------
# Vazio em desenvolvimento: sessao em memoria. Obrigatorio em producao.
# REDIS_URL=redis://localhost:6379

# --- Origens permitidas ----------------------------------------------------
# Lista fechada, separada por virgula. Em producao, todas precisam ser https.
ORIGENS_PERMITIDAS=http://localhost:5173,http://localhost:5174

# URL publica do portal do paciente, usada para montar o link magico.
PORTAL_URL=http://localhost:5174

# Diretorio do armazenamento privado de midia clinica.
MIDIA_DIR=./uploads

# Nivel de log. Em producao use `info`: debug/trace registram corpo de requisicao.
LOG_NIVEL=info
