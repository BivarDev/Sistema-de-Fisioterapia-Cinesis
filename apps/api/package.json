{
  "name": "@cinesis/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend do Cinesis — Fastify, Drizzle e PostgreSQL. Monólito modular.",
  "author": "BivarDev",
  "license": "MIT",
  "type": "module",
  "main": "./dist/servidor.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/servidor.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/servidor.js",
    "db:push": "tsx --env-file-if-exists=../../.env src/db/aplicar-schema.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/semear.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@cinesis/domain": "*",
    "@cinesis/security": "*",
    "@cinesis/shared": "*",
    "@electric-sql/pglite": "^0.3.11",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^4.1.12"
  }
}
